# LOCKIN local edition needs no cloud credentials.
# Data is stored in .lockin-data/data.json by default.
# Set this only if you want the local data file somewhere else.
# LOCKIN_DATA_DIR=/absolute/path/to/lockin-data

# Optional AI recap narration (off by default; not required).
ENABLE_AI_INSIGHTS=false
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
